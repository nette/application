use:
	- nette
	- modernizations

typeAnalysis: phpstan

paths:
	- src
	- tests

excludePaths:
	- tests/**/expected
	- tests/**/fixtures*

fileExtensions:
	- php
	- phpt

imports: {grouping: {class: grouped}}

overrides:
	-
		paths: [src]
		nameResolution: certain
		use:
			- compilerOptimizations
			- deprecations

	- # the deprecated ArrayAccess keeps its parameter names
		paths:
			- src/Application/Routers/RouteList.php
			- src/Application/UI/Component.php
		classes: {overridingMethod: {parameterName: keep}}
