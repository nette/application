<?php declare(strict_types=1);

/**
 * Test: ApplicationExtension checks presenters
 */

use Nette\Application;
use Nette\Bridges\ApplicationDI\ApplicationExtension;
use Tester\Assert;

require __DIR__ . '/../bootstrap.php';


class OverridingPresenter extends Application\UI\Presenter
{
	protected function createRequest(Application\UI\Component $component, string $destination, array $args, string $mode): ?string
	{
		return null;
	}
}


class ChildPresenter extends OverridingPresenter
{
}


function checkPresenter(string $class): void
{
	(fn() => $this->checkPresenter($class))->call(new ApplicationExtension);
}


Assert::error(
	fn() => checkPresenter(ChildPresenter::class),
	E_USER_WARNING,
	'Method OverridingPresenter::createRequest() is no longer called, overriding it has no effect; links are generated by Nette\Application\LinkGenerator.',
);

Assert::noError(fn() => checkPresenter(Application\UI\Presenter::class));
